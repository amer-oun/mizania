# Copy to .env:  copy .env.example .env   (PowerShell: Copy-Item .env.example .env)

# Docker host ports. Change these if something else already uses them
# (for example a local PostgreSQL install on 5432).
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# PostgreSQL
POSTGRES_USER=mizania
POSTGRES_PASSWORD=mizania
POSTGRES_DB=mizania
DATABASE_URL=postgres://mizania:mizania@localhost:5432/mizania

# Redis
REDIS_URL=redis://localhost:6379

# Mail (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025

# API
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

# Copy to .env:  copy .env.example .env   (PowerShell: Copy-Item .env.example .env)

# Docker host ports. Change these if something else already uses them
# (for example a local PostgreSQL install on 5432).
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# PostgreSQL
POSTGRES_USER=mizania
POSTGRES_PASSWORD=mizania
POSTGRES_DB=mizania
DATABASE_URL=postgres://mizania:mizania@localhost:5432/mizania

# Redis
REDIS_URL=redis://localhost:6379

# Mail. Locally: Mailpit (no login, see http://localhost:8025).
# Production (Vercel): Gmail SMTP on port 465 with an app password.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Mizania <you@example.com>"

# Auth (Better Auth). Generate a secret (at least 32 characters) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-base64-string
# Where the app runs; used in email links. Set in Vercel for Production only:
# Preview deployments use their own URLs (Vercel's VERCEL_URL and
# VERCEL_BRANCH_URL system variables).
BETTER_AUTH_URL=http://localhost:3000

# API
API_HOST=0.0.0.0
API_PORT=4000
LOG_LEVEL=info

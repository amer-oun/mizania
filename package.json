{
  "name": "mizania",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @mizania/db db:generate",
    "db:migrate": "pnpm --filter @mizania/db db:migrate",
    "db:seed": "pnpm --filter @mizania/db db:seed",
    "clean": "turbo run clean && rimraf node_modules .turbo"
  },
  "prettier": "@mizania/config/prettier",
  "devDependencies": {
    "@mizania/config": "workspace:*",
    "prettier": "^3.9.9",
    "rimraf": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  }
}

{
  "name": "@mizania/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations and seed.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",

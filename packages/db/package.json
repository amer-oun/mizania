{
  "name": "@mizania/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations and seed.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./budget": "./src/budget/budget.ts",
    "./client": "./src/client.ts",
    "./expenses": "./src/expenses/expenses.ts",
    "./onboarding": "./src/onboarding/save-onboarding.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/test/test-database.ts",
    "./testing/global-setup": "./src/test/global-setup.ts",
    "./wallets": "./src/wallets/wallets.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf .turbo"
  },
  "dependencies": {
    "@mizania/core": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@mizania/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.11",
    "eslint": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
